# Google Apps Script Web App URL that the "Next" button on the application
# form posts step-1 leads to, so they land as rows in a Google Sheet.
GOOGLE_SHEETS_WEBHOOK_URL=

# Canonical site URL — used for sitemap entries, canonical tags and OG metadata.
NEXT_PUBLIC_SITE_URL=https://atozgsm.com

# Meta (Facebook) Pixel ID. Leave empty and no tracking script is loaded at all.
# Find it in Meta Events Manager > Data Sources > your pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Anthropic API key for the AI advisor (/ai-advisor). Server-side only — never
# prefix this with NEXT_PUBLIC_, that would expose the key to every visitor.
ANTHROPIC_API_KEY=

# Shows the free/premium preview switcher. Development only — it lets anyone
# unlock Premium content, so this must stay unset in production.
NEXT_PUBLIC_SHOW_TIER_TOGGLE=

# --- Student portal ---
# Where the local SQLite database lives. Replace with Postgres before deploying —
# a file database does not persist on serverless hosts.
DATABASE_PATH=

# Where uploaded student documents are written. Must NOT be inside public/.
UPLOAD_DIR=

# --- Meta Conversions API (server-side tracking) ---
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would expose the token.
META_CAPI_ACCESS_TOKEN=
# Optional: while testing, paste the code from Events Manager > Test Events.
META_CAPI_TEST_EVENT_CODE=

# --- ElevenLabs voice assistant ---
# Public agent ID from the ElevenLabs dashboard. Empty = widget never loads.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
